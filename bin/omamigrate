#!/usr/bin/env bash
# ==============================================================================
# OmaMigrate: One-click Omarchy Linux Ecosystem Migration CLI
# ==============================================================================
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
LIB_DIR="$(cd "${BIN_DIR}/../lib" && pwd)"
source "${LIB_DIR}/core.sh"
source "${LIB_DIR}/ai-state.sh"

VERSION="1.0.0"

show_help() {
  cat << 'HELP_TXT'
OmaMigrate v1.0.0
Move apps, AI credentials, proxy services, system configurations, and workflows between Omarchy machines.

Usage:
  omamigrate <command> [options]

Commands:
  backup [output]        Create a portable migration backup
  restore <backup_file>  Restore a migration backup from a specific file
  send [backup_file]     Open a migration backup in LocalSend for local transfer
  status                 Show the migration inventory summary
  version                Show the installed version
  help [command]         Show global or command-specific help

Compatibility:
  export                 Alias for backup

Examples:
  omamigrate backup
  omamigrate backup --with-ai-history
  omamigrate backup --complete ~/my-migrate-backup.tar.gz
  omamigrate send ~/omamigrate-backup.tar.gz
  omamigrate restore ~/Downloads/omamigrate-backup.tar.gz

Run 'omamigrate help <command>' for command-specific options.
HELP_TXT
}

show_backup_help() {
  cat << 'HELP_TXT'
Usage:
  omamigrate backup [output] [options]

Create a portable migration backup for another Omarchy machine.

Options:
  --standard         Create the recommended backup without AI histories or plugins
  --complete         Include AI histories, sessions, and plugins; size depends on local data
  --with-ai-history  Include AI histories, sessions, and plugins; equivalent to --complete
  -h, --help         Show this help message

The default output is ~/omamigrate-<hostname>-<YYYYMMDD-HHMMSS>.tar.gz.

Compatibility alias:
  omamigrate export

Examples:
  omamigrate backup
  omamigrate backup --with-ai-history
  omamigrate backup ~/Downloads/workstation-migrate.tar.gz --complete
HELP_TXT
}

show_restore_help() {
  cat << 'HELP_TXT'
Usage:
  omamigrate restore <backup_file>

Restore apps, AI credentials, proxy services, system configurations, and workflows from a specific migration backup.

Arguments:
  backup_file  Path to the .tar.gz or .tgz migration backup

Options:
  -h, --help   Show this help message

Example:
  omamigrate restore ~/Downloads/omamigrate-backup.tar.gz
HELP_TXT
}

show_send_help() {
  cat << 'HELP_TXT'
Usage:
  omamigrate send [backup_file]

Open the selected migration backup in LocalSend for direct transfer to a nearby
device over the local network. This does not upload the backup to cloud storage.

Arguments:
  backup_file  Optional path to a migration backup

Options:
  -h, --help   Show this help message

When omitted, the newest migration backup in ~ or ~/Downloads is automatically selected.
HELP_TXT
}

show_status_help() {
  cat << 'HELP_TXT'
Usage:
  omamigrate status

Show a summary of packages, desktop configurations, AI tools, proxy services, and automated workflows available for migration.

Options:
  -h, --help  Show this help message
HELP_TXT
}

show_command_help() {
  case "${1:-}" in
    backup|export) show_backup_help ;;
    restore) show_restore_help ;;
    send) show_send_help ;;
    status) show_status_help ;;
    version) echo "Usage: omamigrate version" ;;
    "") show_help ;;
    *)
      msg_error "Unknown help topic: $1"
      show_help
      return 1
      ;;
  esac
}

cmd_backup() {
  local host_slug="$(hostname -s 2>/dev/null || echo "omarchy")"
  host_slug="$(echo "${host_slug}" | tr -cd '[:alnum:]_-')"
  [ -z "${host_slug}" ] && host_slug="omarchy"
  local timestamp="$(date +%Y%m%d-%H%M%S)"
  local target="$HOME/omamigrate-${host_slug}-${timestamp}.tar.gz"
  local full_ai="${OMAMIGRATE_FULL_AI:-0}"
  local target_set=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --standard)
        full_ai=0
        ;;
      --complete|--with-ai-history|--with-history|--full)
        full_ai=1
        ;;
      -h|--help)
        show_backup_help
        return 0
        ;;
      --)
        shift
        if [ "$#" -gt 1 ]; then
          msg_error "Backup accepts only one output file."
          return 2
        fi
        if [ "$#" -eq 1 ]; then
          target="$1"
          target_set=1
        fi
        break
        ;;
      -*)
        msg_error "Unknown backup option: $1"
        echo "Run 'omamigrate backup --help' for usage." >&2
        return 2
        ;;
      *)
        if [ "$target_set" -eq 1 ]; then
          msg_error "Backup accepts only one output file."
          return 2
        fi
        target="$1"
        target_set=1
        ;;
    esac
    shift
  done

  OMAMIGRATE_FULL_AI="$full_ai" bash "${LIB_DIR}/export.sh" "$target"
}

RESTORE_DIR=""

cmd_restore() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_restore_help
    return 0
  fi
  if [ "$#" -ne 1 ]; then
    msg_error "Restore requires exactly one backup file."
    echo "Run 'omamigrate restore --help' for usage." >&2
    return 2
  fi
  local archive="${1:-}"
  if [ -z "$archive" ] || [ ! -f "$archive" ]; then
    msg_error "Please specify a valid migration backup to restore."
    echo "Usage: omamigrate restore <backup-file.tar.gz>"
    exit 1
  fi

  # In interactive CLI mode, authenticate sudo ONCE at the start and keep it alive
  if [ -t 0 ] && ! sudo -n true 2>/dev/null; then
    msg_info "Administrator privileges required to restore system configurations & packages."
    sudo -v || { msg_error "Administrator authentication failed."; exit 1; }
  fi

  local staging_base="${XDG_CACHE_HOME:-$HOME/.cache}/omamigrate"
  mkdir -p "$staging_base"
  chmod 700 "$staging_base"
  rm -rf "${staging_base}/restore-"* 2>/dev/null || true

  RESTORE_DIR="$(mktemp -d "${staging_base}/restore-XXXXXX")"

  if sudo -n true 2>/dev/null; then
    ( while true; do sudo -n -v 2>/dev/null; sleep 15; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_PID=$!
    trap 'kill "${SUDO_PID:-}" 2>/dev/null || true; rm -rf "${RESTORE_DIR:-}"' EXIT INT TERM
  else
    trap 'rm -rf "${RESTORE_DIR:-}"' EXIT INT TERM
  fi

  msg_info "Opening migration backup: $(basename "$archive")"
  msg_step "Extracting backup contents..."
  if ! tar -xzf "$archive" -C "$RESTORE_DIR"; then
    msg_error "Failed to extract the backup. Verify the file and available disk space."
    exit 1
  fi
  msg_ok "Migration backup extracted."

  local restore_engine=""
  if [ -f "${LIB_DIR}/restore.sh" ]; then
    restore_engine="${LIB_DIR}/restore.sh"
  elif [ -f "${RESTORE_DIR}/restore.sh" ]; then
    chmod +x "${RESTORE_DIR}/restore.sh"
    restore_engine="${RESTORE_DIR}/restore.sh"
  fi

  if [ -n "$restore_engine" ]; then
    msg_info "Executing restore engine..."
    bash "$restore_engine" "$RESTORE_DIR"
  else
    msg_error "Invalid migration backup: restore.sh was not found."
    exit 1
  fi
}

cmd_send() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_send_help
    return 0
  fi
  if [ "$#" -gt 1 ]; then
    msg_error "Send accepts only one backup file."
    echo "Run 'omamigrate send --help' for usage." >&2
    return 2
  fi
  local archive="${1:-}"
  if [ -z "$archive" ]; then
    local cache_marker="${XDG_CACHE_HOME:-$HOME/.cache}/omamigrate/last_backup"
    if [ -f "$cache_marker" ]; then
      local candidate="$(cat "$cache_marker" 2>/dev/null || true)"
      if [ -n "$candidate" ] && [ -f "$candidate" ]; then
        archive="$candidate"
      fi
    fi
  fi
  if [ -z "$archive" ]; then
    local download_dir=""
    if command -v xdg-user-dir >/dev/null 2>&1; then
      download_dir="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
    fi
    [ -z "$download_dir" ] && download_dir="$HOME/Downloads"
    local search_dirs=("$HOME")
    [ -d "$download_dir" ] && search_dirs+=("$download_dir")

    archive="$(find "${search_dirs[@]}" -maxdepth 2 -type f \( \
      -iname 'omamigrate-*.tar.gz' -o -iname 'omamigrate-*.tgz' -o -iname 'omamigrate-*.tar*.gz' \
      -o -iname '*migrate*.tar.gz' -o -iname '*migration*.tar.gz' \
    \) -printf '%T@\t%p\0' 2>/dev/null | sort -z -r -n -k1,1 | cut -z -f2- | head -z -n 1 | tr -d '\0' || true)"
  fi
  if [ -z "$archive" ] || [ ! -f "$archive" ]; then
    msg_error "No migration backup found to send. Run 'omamigrate backup' first."
    exit 1
  fi


  if command -v localsend >/dev/null 2>&1; then
    msg_info "Opening LocalSend for direct local transfer: ${archive}"
    if command -v systemd-run >/dev/null 2>&1; then
      systemd-run --user --unit="localsend-$(date +%s%N)" localsend "$archive" >/dev/null 2>&1 || true
    elif command -v uwsm-app >/dev/null 2>&1; then
      uwsm-app -- localsend "$archive" >/dev/null 2>&1 || true
    else
      nohup setsid localsend "$archive" </dev/null >/dev/null 2>&1 &
    fi
    msg_ok "LocalSend opened. Select a nearby device for direct local transfer."
  else
    msg_warn "LocalSend is not installed. You can transfer using scp:"
    echo "  scp ${archive} <user>@<new-ip>:~/"
  fi
}

cmd_status() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_status_help
    return 0
  fi
  if [ "$#" -gt 0 ]; then
    msg_error "Status does not accept arguments."
    echo "Run 'omamigrate status --help' for usage." >&2
    return 2
  fi
  msg_info "OmaMigrate System Inventory:"
  msg_step "Explicit Arch packages : $(pacman -Qqe | grep -vE "${HW_EXCLUDE_REGEX}" | wc -l) (filtered)"
  msg_step "Desktop configs       : $(find "$HOME/.config" -maxdepth 1 -type d | wc -l) items in ~/.config"
  local ai_agents=()
  [ -d "$HOME/.claude" ] && ai_agents+=("Claude")
  [ -d "$HOME/.codex" ] && ai_agents+=("Codex")
  [ -d "$HOME/.gemini/antigravity-cli" ] && ai_agents+=("Agy")
  [ -d "$HOME/.pi" ] && ai_agents+=("Pi")
  [ -d "$HOME/.grok" ] && ai_agents+=("Grok")
  { [ -d "$HOME/.omp" ] || [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/omp" ]; } && ai_agents+=("OMP")
  { [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/opencode" ] || \
    [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/opencode" ]; } && ai_agents+=("OpenCode")
  msg_step "AI CLI agents         : ${ai_agents[*]:-None}"
  msg_step "Sing-box configured   : $([ -f /etc/sing-box/config.json ] && echo 'Yes (/etc/sing-box/config.json)' || echo 'No')"
  msg_step "Email triage timer    : $(systemctl --user is-enabled icloud-mail-triage.timer 2>/dev/null || echo 'Not configured')"
  msg_step "Node rotate timer     : $(systemctl is-enabled sing-box-node-rotate.timer 2>/dev/null || echo 'Not configured')"
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    backup|export)
      cmd_backup "$@"
      ;;
    restore)
      cmd_restore "$@"
      ;;
    send)
      cmd_send "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    version|--version|-v)
      echo "OmaMigrate v${VERSION}"
      ;;
    help)
      show_command_help "${1:-}"
      ;;
    --help|-h)
      show_help
      ;;
    *)
      msg_error "Unknown command: ${cmd}"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
