#!/usr/bin/env bash
# ==============================================================================
# OmaMigrate: One-click Omarchy Linux Ecosystem Migration CLI
# ==============================================================================
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
LIB_DIR="$(cd "${BIN_DIR}/../lib" && pwd)"
source "${LIB_DIR}/core.sh"

VERSION="1.0.0"

show_help() {
  cat << 'HELP_TXT'
OmaMigrate v1.0.0
Whole-system ecosystem & environment migration tool for Omarchy Linux.

Usage:
  omamigrate <command> [arguments]

Commands:
  export [output] [--with-history]  Create a portable migration backup (~25MB)
                                    Add --with-history to include full AI chat logs & plugins (~650MB)
  restore <archive_file>            Restore from a portable migration backup
  send [archive_file]               Broadcast the archive over local network using LocalSend
  status                            Check migration readiness and list inventory summary
  version                           Show current version
  help                              Show this help message

Examples:
  omamigrate export
  omamigrate export --with-history
  omamigrate export ~/my-backup.tar.gz
  omamigrate send ~/omamigrate-backup.tar.gz
  omamigrate restore ~/Downloads/omamigrate-backup.tar.gz

HELP_TXT
}

cmd_export() {
  local target="$HOME/omamigrate-backup.tar.gz"
  local full_ai="${OMAMIGRATE_FULL_AI:-0}"

  for arg in "$@"; do
    if [ "$arg" = "--with-history" ] || [ "$arg" = "--full" ]; then
      full_ai=1
    elif [ -n "$arg" ] && [ "${arg:0:1}" != "-" ]; then
      target="$arg"
    fi
  done

  OMAMIGRATE_FULL_AI="$full_ai" bash "${LIB_DIR}/export.sh" "$target"
}

RESTORE_DIR=""

cmd_restore() {
  local archive="${1:-}"
  if [ -z "$archive" ] || [ ! -f "$archive" ]; then
    msg_error "Please specify a valid archive file to restore."
    echo "Usage: omamigrate restore <path-to-archive.tar.gz>"
    exit 1
  fi

  # In interactive CLI mode, authenticate sudo ONCE at the start and keep it alive
  if [ -t 0 ] && ! sudo -n true 2>/dev/null; then
    msg_info "Administrator privileges required to restore system configurations & packages."
    sudo -v || { msg_error "Administrator authentication failed."; exit 1; }
  fi

  local staging_base="${XDG_CACHE_HOME:-$HOME/.cache}/omamigrate"
  mkdir -p "$staging_base"
  chmod 700 "$staging_base"
  rm -rf "${staging_base}/restore-"* 2>/dev/null || true

  RESTORE_DIR="$(mktemp -d "${staging_base}/restore-XXXXXX")"

  if sudo -n true 2>/dev/null; then
    ( while true; do sudo -n -v 2>/dev/null; sleep 15; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_PID=$!
    trap 'kill "${SUDO_PID:-}" 2>/dev/null || true; rm -rf "${RESTORE_DIR:-}"' EXIT INT TERM
  else
    trap 'rm -rf "${RESTORE_DIR:-}"' EXIT INT TERM
  fi

  msg_info "Extracting migration bundle from $(basename "$archive")..."
  msg_step "Extracting staging contents..."
  if ! tar -xzf "$archive" -C "$RESTORE_DIR"; then
    msg_error "Failed to extract archive contents. Ensure sufficient disk space."
    exit 1
  fi
  msg_ok "Migration bundle extracted."

  local restore_engine=""
  if [ -f "${LIB_DIR}/restore.sh" ]; then
    restore_engine="${LIB_DIR}/restore.sh"
  elif [ -f "${RESTORE_DIR}/restore.sh" ]; then
    chmod +x "${RESTORE_DIR}/restore.sh"
    restore_engine="${RESTORE_DIR}/restore.sh"
  fi

  if [ -n "$restore_engine" ]; then
    msg_info "Executing restore engine..."
    bash "$restore_engine" "$RESTORE_DIR"
  else
    msg_error "Invalid archive: restore.sh not found inside bundle."
    exit 1
  fi
}

cmd_send() {
  local archive="${1:-$HOME/omamigrate-backup.tar.gz}"
  if [ "$#" -eq 0 ] && [ ! -f "$archive" ] && [ -f "$HOME/omarchy-migration.tar.gz" ]; then
    archive="$HOME/omarchy-migration.tar.gz"
  fi
  if [ ! -f "$archive" ]; then
    msg_error "Archive file not found: ${archive}"
    exit 1
  fi

  if command -v localsend >/dev/null 2>&1; then
    msg_info "Opening LocalSend to transfer ${archive}..."
    if command -v systemd-run >/dev/null 2>&1; then
      systemd-run --user --unit="localsend-$(date +%s%N)" localsend "$archive" >/dev/null 2>&1 || true
    elif command -v uwsm-app >/dev/null 2>&1; then
      uwsm-app -- localsend "$archive" >/dev/null 2>&1 || true
    else
      nohup setsid localsend "$archive" </dev/null >/dev/null 2>&1 &
    fi
    msg_ok "LocalSend launched. Select your new device in the UI to beam the bundle!"
  else
    msg_warn "LocalSend is not installed. You can transfer using scp:"
    echo "  scp ${archive} <user>@<new-ip>:~/"
  fi
}

cmd_status() {
  msg_info "OmaMigrate System Inventory:"
  msg_step "Explicit Arch packages : $(pacman -Qqe | grep -vE "${HW_EXCLUDE_REGEX}" | wc -l) (filtered)"
  msg_step "Desktop configs       : $(find "$HOME/.config" -maxdepth 1 -type d | wc -l) items in ~/.config"
  msg_step "AI CLI agents         : $(ls -d "$HOME"/.claude "$HOME"/.codex "$HOME"/.gemini "$HOME"/.grok 2>/dev/null | xargs -n1 basename | tr '\n' ' ')"
  msg_step "Sing-box configured   : $([ -f /etc/sing-box/config.json ] && echo 'Yes (/etc/sing-box/config.json)' || echo 'No')"
  msg_step "Email triage timer    : $(systemctl --user is-enabled icloud-mail-triage.timer 2>/dev/null || echo 'Not configured')"
  msg_step "Node rotate timer     : $(systemctl is-enabled sing-box-node-rotate.timer 2>/dev/null || echo 'Not configured')"
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    export)
      cmd_export "$@"
      ;;
    restore)
      cmd_restore "$@"
      ;;
    send)
      cmd_send "$@"
      ;;
    status)
      cmd_status
      ;;
    version|--version|-v)
      echo "OmaMigrate v${VERSION}"
      ;;
    help|--help|-h)
      show_help
      ;;
    *)
      msg_error "Unknown command: ${cmd}"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
